global:
  resolve_timeout: 5m

route:
  receiver: slack-warning
  group_by:
    - alertname
    - service
    - severity
  group_wait: 30s
  group_interval: 10m
  repeat_interval: 4h
  routes:
    - matchers:
        - severity="critical"
      receiver: slack-critical
      repeat_interval: 30m

receivers:
  - name: slack-warning
    slack_configs:
      - api_url: "__SLACK_METRICS_ALERT_WEBHOOK_URL__"
        send_resolved: true
        username: "rolling-alertmanager"
        icon_emoji: ":satellite:"
        color: "warning"
        title: >-
          [ROLLING API][__SLACK_METRICS_ALERT_ENVIRONMENT__][{{ if eq .CommonLabels.severity "critical" }}치명/CRITICAL{{ else }}경고/WARNING{{ end }}][{{ if eq .Status "resolved" }}복구/RESOLVED{{ else }}발생/FIRING{{ end }}] {{ .CommonAnnotations.summary }}
        text: |-
          *무슨 문제인가*: {{ .CommonAnnotations.description }}
          {{ if .CommonAnnotations.current_value_hint }}*확인된 값*: {{ .CommonAnnotations.current_value_hint }}{{ end }}
          {{ if .CommonAnnotations.threshold_hint }}*기준*: {{ .CommonAnnotations.threshold_hint }}{{ end }}
          {{ if .CommonAnnotations.observation_window }}*관찰 구간*: {{ .CommonAnnotations.observation_window }}{{ end }}
          {{ if .CommonAnnotations.runbook }}*지금 확인할 것*: {{ .CommonAnnotations.runbook }}{{ end }}
          {{ if .CommonAnnotations.dashboard_path }}*대시보드*: __GRAFANA_ROOT_URL__{{ .CommonAnnotations.dashboard_path }}{{ end }}

  - name: slack-critical
    slack_configs:
      - api_url: "__SLACK_METRICS_ALERT_WEBHOOK_URL__"
        send_resolved: true
        username: "rolling-alertmanager"
        icon_emoji: ":rotating_light:"
        color: "danger"
        title: >-
          [ROLLING API][__SLACK_METRICS_ALERT_ENVIRONMENT__][{{ if eq .CommonLabels.severity "critical" }}치명/CRITICAL{{ else }}경고/WARNING{{ end }}][{{ if eq .Status "resolved" }}복구/RESOLVED{{ else }}발생/FIRING{{ end }}] {{ .CommonAnnotations.summary }}
        text: |-
          *무슨 문제인가*: {{ .CommonAnnotations.description }}
          {{ if .CommonAnnotations.current_value_hint }}*확인된 값*: {{ .CommonAnnotations.current_value_hint }}{{ end }}
          {{ if .CommonAnnotations.threshold_hint }}*기준*: {{ .CommonAnnotations.threshold_hint }}{{ end }}
          {{ if .CommonAnnotations.observation_window }}*관찰 구간*: {{ .CommonAnnotations.observation_window }}{{ end }}
          {{ if .CommonAnnotations.runbook }}*지금 확인할 것*: {{ .CommonAnnotations.runbook }}{{ end }}
          {{ if .CommonAnnotations.dashboard_path }}*대시보드*: __GRAFANA_ROOT_URL__{{ .CommonAnnotations.dashboard_path }}{{ end }}
